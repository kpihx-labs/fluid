# --- Fluid-K3s: Agnostic Cluster Configuration (Universal Registry) ---
# PURPOSE: This file is the single source of truth for the entire federation.
# WHY: Transition to a 100% DECENTRALIZED architecture with Role-Based logic.
# -----------------------------------------------------------------------------

# 📂 Inventory Configuration
# -----------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: ${INVENTORY_PATH:="$SCRIPT_DIR/hosts.json"}

# 🛠️ Inventory Helper Functions
get_node_val() {
    local node_name=$1
    local key=$2
    jq -r ".nodes[] | select(.name == \"$node_name\") | .$key" "$INVENTORY_PATH" 2>/dev/null
}

# WHY: Only nodes with role 'master' participate in the database mesh.
get_db_join_list() {
    jq -r '.nodes[] | select(.role == "master") | .tailscale_ip' "$INVENTORY_PATH" | paste -sd "," -
}

# 🚀 Remote Execution & Privileged Access
# -----------------------------------------------------------------------------
: ${REMOTE_CMD:="ssh"}
: ${SUDO_CMD:="sudo"}
: ${REMOTE_SUDO:="sudo"}

# 🌐 Network & Failover Configuration
# -----------------------------------------------------------------------------
: ${CLUSTER_DOMAIN:="fluid.local"}
: ${CLUSTER_VIP:="10.20.20.250"}
: ${FLUID_BRIDGE:="br-fluid"}
: ${VXLAN_ID:="42"}
: ${VXLAN_PORT:="10442"}
: ${VXLAN_UNDERLAY_INTERFACE:="tailscale0"}
: ${VXLAN_MTU:="1150"}
: ${VXLAN_SUBNET:="10.20.20.0/24"}
: ${CLUSTER_INTERFACE:="vxlan-fluid"}

# 🧠 Decentralized Datastore (CockroachDB Mesh)
# -----------------------------------------------------------------------------
: ${DB_TYPE:="cockroach"}
: ${DB_USER:="root"}
: ${DB_NAME:="k3s"}
: ${DB_PORT:="26257"}
: ${DB_HTTP_PORT:="8080"}

# WHY: Masters talk to local DB. Minions talk to any Master.
# We determine the host IP based on our role.
: ${DB_HOST:="127.0.0.1"}

# 🏗️ Proxmox (PVE) Provisioning Defaults
# -----------------------------------------------------------------------------
: ${PVE_HOST:="pve"}
: ${PVE_STORAGE:="local-lvm"}
: ${VM_ID_START:="100"}
: ${VM_NAME_PREFIX:="fluid-k3s-node"}
: ${VM_MEMORY:="4096"}
: ${VM_CORES:="2"}
: ${VM_DISK_SIZE:="20"}

# 🛰️ Current Node Context Detection
# -----------------------------------------------------------------------------
CURRENT_HOSTNAME=$(hostname)
NODE_MATCH=$(jq -r ".nodes[] | select(\"$CURRENT_HOSTNAME\" | contains(.name)) | .name" "$INVENTORY_PATH" | head -n 1)

if [ -n "$NODE_MATCH" ] && [ "$NODE_MATCH" != "null" ]; then
    export NODE_NAME="$NODE_MATCH"
    export NODE_OS=$(get_node_val "$NODE_NAME" "os")
    export NODE_ROLE=$(get_node_val "$NODE_NAME" "role")
    export NODE_IP=$(get_node_val "$NODE_NAME" "tailscale_ip")
    export NODE_VXLAN_IP=$(get_node_val "$NODE_NAME" "vxlan_ip")
    echo "[CONFIG] Node Detected: $NODE_NAME (OS: $NODE_OS, Role: $NODE_ROLE, IP: $NODE_IP)"
else
    export NODE_NAME="$CURRENT_HOSTNAME"
    export NODE_OS="linux"
    export NODE_ROLE="minion"
    echo "[WARNING] Node '$CURRENT_HOSTNAME' not in inventory. Defaulting to Minion role."
fi

# 📁 Storage & Versions
# -----------------------------------------------------------------------------
: ${LONGHORN_REPLICAS:="2"}
: ${K3S_VERSION:="v1.33.10+k3s1"}
: ${COCKROACH_VERSION:="v23.2.3"}
: ${LONGHORN_VERSION:="v1.6.1"}
: ${ESO_VERSION:="v2.4.0"}
: ${KEDA_VERSION:="2.13.0"}
: ${K3S_TOKEN:=""}
