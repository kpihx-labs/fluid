#!/usr/bin/env bash
# Global Fluid defaults.

FABRIC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLUID_ROOT="$(cd "$FABRIC_DIR/.." && pwd)"

# Core layout
: "${FLUID_NAME:="fluid"}"
: "${FLUID_FABRIC_DIR:="$FLUID_ROOT/fabric"}"
: "${FLUID_HOSTS_PATH:="$FLUID_FABRIC_DIR/hosts.json"}"
: "${FLUID_PROFILES_DIR:="$FLUID_FABRIC_DIR/profiles"}"
: "${FLUID_POLICIES_DIR:="$FLUID_FABRIC_DIR/policies"}"

# Policy files
: "${FLUID_NETWORK_POLICY_PATH:="$FLUID_POLICIES_DIR/network.json"}"
: "${FLUID_AUTHORITY_POLICY_PATH:="$FLUID_POLICIES_DIR/authority.json"}"
: "${FLUID_CONTINUITY_POLICY_PATH:="$FLUID_POLICIES_DIR/continuity.json"}"
: "${FLUID_ACCESS_POLICY_PATH:="$FLUID_POLICIES_DIR/access.json"}"

# Mutable state and generated output
: "${FLUID_STATE_DIR:="$FLUID_ROOT/state"}"
: "${FLUID_STATE_PATH:="$FLUID_STATE_DIR/cluster-state.json"}"
: "${FLUID_RENDER_DIR:="$FLUID_ROOT/render"}"
: "${FLUID_CONTINUITY_RENDER_DIR:="$FLUID_RENDER_DIR/continuity"}"
: "${FLUID_ACCESS_RENDER_DIR:="$FLUID_RENDER_DIR/access"}"
: "${FLUID_PROJECT_RENDER_DIR:="$FLUID_RENDER_DIR/projects"}"
: "${FLUID_BACKUP_DIR:="$FLUID_RENDER_DIR/backups"}"

# Stable references
: "${FLUID_TEMPLATES_DIR:="$FLUID_ROOT/templates"}"
: "${FLUID_DOCS_DIR:="$FLUID_ROOT/docs"}"

# Operator behavior
: "${FLUID_DRY_RUN:="false"}"
: "${FLUID_EXPLAIN_ONLY:="false"}"
: "${FLUID_FORCE:="false"}"
: "${FLUID_PRIVILEGE_TOOL:="sudo"}"

# Network defaults
: "${FLUID_UNDERLAY:="tailscale"}"
: "${FLUID_UNDERLAY_INTERFACE:="tailscale0"}"
: "${FLUID_REQUIRE_TAILSCALE:="true"}"
: "${FLUID_TAILSCALE_STATUS_CMD:="tailscale status --json"}"
: "${FLUID_ADVERTISE_MODE:="tailscale-ip"}"

# Authority defaults
: "${FLUID_DEFAULT_AUTHORITY_SIZE:="3"}"
: "${FLUID_MIN_AUTHORITY_SIZE:="1"}"
: "${FLUID_AUTHORITY_REQUIRE_SURVIVOR_CAPABLE:="true"}"
: "${FLUID_AUTHORITY_REQUIRE_ELIGIBLE:="true"}"
: "${FLUID_AUTHORITY_REQUIRE_MANAGER_ROLE:="true"}"

# Filesystem roots
: "${FLUID_SYSTEMD_UNIT_DIR:="/etc/systemd/system"}"
: "${FLUID_ETC_ROOT:="/etc/fluid"}"
: "${FLUID_VAR_ROOT:="/var/lib/fluid"}"

# Docker Swarm defaults
: "${FLUID_SWARM_LISTEN_ADDR:="0.0.0.0:2377"}"
: "${FLUID_SWARM_OVERLAY_PORT:="4789"}"
: "${FLUID_SWARM_MANAGER_LABEL:="fluid.role=manager"}"
: "${FLUID_SWARM_WORKER_LABEL:="fluid.role=worker"}"

# Deploy defaults
: "${FLUID_PROJECT_CONFIG_NAME:="fluid.yml"}"
: "${FLUID_PROJECT_DEFAULT_COMPOSE_FILE:="docker-compose.yml"}"
: "${FLUID_PROJECT_DEFAULT_STACK_PREFIX:="fluid"}"
: "${FLUID_PROJECT_DEPLOY_WITH_REGISTRY_AUTH:="true"}"

# Backups
: "${FLUID_BACKUP_RETENTION:="10"}"
: "${FLUID_BACKUP_NAME_PREFIX:="portable-truth"}"
: "${FLUID_RESTORE_DEFAULT_DIR:="/tmp/fluid-restore"}"
: "${FLUID_VALIDATE_RESTORE_DIR:="/tmp/fluid-restore-validation"}"

# Continuity defaults
: "${CONTINUITY_ENABLED_DEFAULT:="true"}"
: "${CONTINUITY_INSTALL_ROOT_DEFAULT:="$FLUID_ETC_ROOT/continuity"}"
: "${CONTINUITY_STATE_DIR_DEFAULT:="$FLUID_VAR_ROOT/state"}"
: "${CONTINUITY_STATE_GUARD_UNIT_DEFAULT:="fluid-state-guard.service"}"
: "${CONTINUITY_AUTHORITY_MARKER_UNIT_DEFAULT:="fluid-authority-marker.service"}"
: "${CONTINUITY_BACKUP_TRIGGER_UNIT_DEFAULT:="fluid-backup-trigger.service"}"
: "${CONTINUITY_BACKUP_TRIGGER_TIMER_DEFAULT:="fluid-backup-trigger.timer"}"
: "${CONTINUITY_RECOVERY_SHELL_UNIT_DEFAULT:="fluid-recovery-shell.service"}"
: "${CONTINUITY_BACKUP_ON_CALENDAR_DEFAULT:="hourly"}"
: "${CONTINUITY_MARKER_FILE_DEFAULT:="$FLUID_VAR_ROOT/state/authority-marker.env"}"

# Tailscale access adapter
: "${FLUID_TAILSCALE_TAILNET:=""}"
: "${FLUID_TAILSCALE_API_KEY:=""}"
