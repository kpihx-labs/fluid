{
  "extends": "linux",
  "platform": "pve",
  "survivor_capable": true,
  "execution_capable": true,
  "authority_eligible": true,
  "capabilities": {
    "swarm_manager": true,
    "swarm_worker": true,
    "continuity_host": true,
    "portable_truth_replica": true,
    "artifact_cache": true,
    "snapshot_store": true
  },
  "policy": {
    "promotion_weight": 100,
    "resource_profile": "stable-core",
    "availability_profile": "stable",
    "continuity_tier": "critical",
    "authority_policy": "eligible"
  },
  "swarm": {
    "labels": {
      "fluid.class": "core",
      "fluid.storage": "local",
      "fluid.site": "pve"
    }
  },
  "runtime": {
    "package_hint_env": "FLUID_PVE_PACKAGES"
  }
}
