{
  "extends": "linux",
  "platform": "wsl",
  "survivor_capable": false,
  "execution_capable": true,
  "authority_eligible": false,
  "capabilities": {
    "swarm_manager": false,
    "swarm_worker": true,
    "continuity_host": false,
    "portable_truth_replica": false,
    "artifact_cache": false,
    "snapshot_store": false
  },
  "policy": {
    "promotion_weight": 10,
    "resource_profile": "dev-only",
    "availability_profile": "variable",
    "continuity_tier": "none",
    "service_classes_allowed": ["tool"],
    "authority_policy": "manual-only"
  },
  "swarm": {
    "labels": {
      "fluid.class": "tool",
      "fluid.storage": "ephemeral"
    }
  },
  "runtime": {
    "supports_swarm_install": false,
    "supports_swarm_apply": false,
    "supports_continuity_apply": false
  }
}
