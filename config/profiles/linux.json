{
  "platform": "linux",
  "survivor_capable": false,
  "execution_capable": true,
  "authority_eligible": false,
  "capabilities": {
    "swarm_manager": false,
    "swarm_worker": true,
    "continuity_host": true,
    "portable_truth_replica": false,
    "artifact_cache": false,
    "snapshot_store": false
  },
  "policy": {
    "promotion_weight": 50,
    "resource_profile": "balanced",
    "availability_profile": "variable",
    "continuity_tier": "standard",
    "service_classes_allowed": ["core", "app", "tool", "ai"],
    "ownership_class": "personal",
    "authority_policy": "manual-only"
  },
  "storage": {
    "snapshot_paths": ["/var/lib/fluid/snapshots"],
    "restore_assets": ["/var/lib/fluid/restore"],
    "local_persistent_paths": ["/var/lib/fluid"]
  },
  "swarm": {
    "labels": {
      "fluid.class": "app",
      "fluid.storage": "local"
    }
  },
  "resources": {
    "continuity": {
      "enabled": true,
      "backup_on_calendar": "hourly"
    }
  },
  "runtime": {
    "init_system": "systemd",
    "supports_swarm_install": true,
    "supports_swarm_apply": true,
    "supports_continuity_apply": true,
    "package_hint_env": "FLUID_LINUX_PACKAGES"
  }
}
