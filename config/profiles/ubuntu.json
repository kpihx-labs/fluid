{
  "extends": "linux",
  "platform": "ubuntu",
  "survivor_capable": true,
  "execution_capable": true,
  "authority_eligible": true,
  "capabilities": {
    "swarm_manager": true,
    "swarm_worker": true,
    "continuity_host": true,
    "portable_truth_replica": true,
    "artifact_cache": true,
    "snapshot_store": true
  },
  "policy": {
    "promotion_weight": 95,
    "resource_profile": "app-core",
    "availability_profile": "stable",
    "continuity_tier": "critical",
    "authority_policy": "eligible"
  },
  "swarm": {
    "labels": {
      "fluid.class": "app",
      "fluid.storage": "local",
      "fluid.site": "ubuntu"
    }
  },
  "runtime": {
    "package_hint_env": "FLUID_UBUNTU_PACKAGES"
  }
}
